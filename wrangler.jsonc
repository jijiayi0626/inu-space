{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inu-space-pass",
  "main": "worker/index.js",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inu-space-db",
      "database_id": "18536ad1-9472-453f-92da-8016479f8944"
    }
  ]
}
